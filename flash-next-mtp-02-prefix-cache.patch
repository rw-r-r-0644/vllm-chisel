+def _annotate_mtp_draft_groups(
+    vllm_config: VllmConfig,
+    kv_cache_spec: dict[str, KVCacheSpec],
+    kv_cache_groups: list[KVCacheGroupSpec],
+) -> None:
+    # Isolate Qwen4Exp MTP draft (e.g. mtp.layers.48...) as the sole draft
+    # group; exempt Mamba groups so target prefix caching survives.
+    spec_config = vllm_config.speculative_config
+    if spec_config is None or not spec_config.use_eagle():
+        return
+    draft_names = {n for n in kv_cache_spec if "mtp" in n.lower()}
+    if not draft_names:
+        return
+    for group in kv_cache_groups:
+        if any(isinstance(s, MambaSpec) for s in iter_layer_specs(group.kv_cache_spec)):
+            group.is_eagle_group = False
+    extra: list[KVCacheGroupSpec] = []
+    for group in list(kv_cache_groups):
+        draft = [n for n in group.layer_names if n in draft_names]
+        if not draft:
+            continue
+        if len(draft) == len(group.layer_names):
+            # Pure draft group (never Mamba: draft has no recurrent state).
+            if not any(
+                isinstance(s, MambaSpec)
+                for s in iter_layer_specs(group.kv_cache_spec)
+            ):
+                group.is_eagle_group = True
+            continue
+        target = [n for n in group.layer_names if n not in draft_names]
+        spec = group.kv_cache_spec
+        if isinstance(spec, UniformTypeKVCacheSpecs):
+            t_spec = UniformTypeKVCacheSpecs.from_specs(
+                {n: spec.kv_cache_specs[n] for n in target}
+            )
+            d_spec = UniformTypeKVCacheSpecs.from_specs(
+                {n: spec.kv_cache_specs[n] for n in draft}
+            )
+            if t_spec is None or d_spec is None:
+                group.is_eagle_group = True
+                continue
+            group.layer_names = target
+            group.kv_cache_spec = t_spec
+            group.is_eagle_group = False
+            extra.append(
+                replace(
+                    group,
+                    layer_names=list(draft),
+                    kv_cache_spec=d_spec,
+                    is_eagle_group=True,
+                )
+            )
+        else:
+            group.layer_names = target
+            group.is_eagle_group = False
+            extra.append(replace(group, layer_names=list(draft), is_eagle_group=True))
+    kv_cache_groups.extend(extra)
+
+
 def _annotate_eagle_groups(
