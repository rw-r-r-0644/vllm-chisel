+    prefetch_from_model_state: bool      # set in __init__ from VLLM_PLE_HOST_GATHER
+
+    # Measured on 3 x RTX 3090. Inside the forward, the device-to-host copy of
+    # the ids blocks the host every step. The host cannot run ahead of the GPU,
+    # and the eager segments on each rank (12 GDN, 4 QSA, 1 PLE short conv)
+    # become GPU idle time. Single-stream decode was 45 tok/s with a GPU-busy
+    # floor of 12.6 ms. Moving the gather out of the forward alone gave
+    # 45.1 tok/s. Moving it out and using FULL_DECODE_ONLY gave 80 tok/s.
+
+    def host_gather(self, ngram_ids: torch.Tensor) -> None:
+        """Fill the lookup buffer. Called before the forward.
+
+        The H2D copy runs on the calling stream, which the forward or its graph
+        replay uses next, so no event is needed.
+        """
+        slot_size, _ = self._get_dp_gather_slot(ngram_ids.shape[0])
+        gathered_ids = self._gather_dp_ids(ngram_ids, slot_size)
+        self._lookup(
+            gathered_ids,
+            output=self._prefetch_buffer[: gathered_ids.shape[0]],
+        )
+
+    def start_prefetch(
+        self,
+        hidden_states: torch.Tensor,
+        ngram_ids: torch.Tensor,
+    ) -> None:
+        """Old in-forward path. Does nothing when host_gather() is used."""
+        if self.prefetch_from_model_state:
+            return
+        super().start_prefetch(hidden_states, ngram_ids)
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        """Return a view of the rows host_gather() wrote.
+
+        With ETP=1 the all-reduce and DP row selection in _finalize_prefetch do
+        nothing, so only the flatten(-2) remains.
+        """
+        if not self.prefetch_from_model_state:
+            return super().forward(hidden_states)
+        return self._prefetch_buffer[: hidden_states.shape[0]].flatten(-2)
+
 
