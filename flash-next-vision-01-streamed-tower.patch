+class _HostStreamedBlocks:
+    """Keep the ViT blocks in pinned host memory and stage each block into
+    one of two GPU slots just before it runs, prefetching the next block on a
+    side stream. Everything outside ``blocks`` (patch/pos embed, merger) moves
+    to the GPU. Resident cost is two blocks instead of the whole tower."""
+
+    def __init__(
+        self, tower: nn.Module, blocks: nn.ModuleList, device: torch.device
+    ) -> None:
+        block_ids = {id(p) for p in blocks.parameters()}
+        for p in tower.parameters():
+            if id(p) not in block_ids:
+                p.data = p.data.to(device)
+        for b in tower.buffers():
+            b.data = b.data.to(device)
+
+        self.blocks = list(blocks)
+        self.params: list[list[nn.Parameter]] = []
+        self.host: list[list[torch.Tensor]] = []
+        numel = 0
+        dtype = None
+        for blk in self.blocks:
+            ps = list(blk.parameters())
+            self.params.append(ps)
+            self.host.append([p.data.contiguous().pin_memory() for p in ps])
+            for p, h in zip(ps, self.host[-1]):
+                p.data = h
+            numel = max(numel, sum(p.numel() for p in ps))
+            dt = {p.dtype for p in ps}
+            assert len(dt) == 1, dt
+            dtype = dt.pop() if dtype is None else dtype
+        self.slots = [torch.empty(numel, dtype=dtype, device=device) for _ in range(2)]
+        self.copy_stream = torch.cuda.Stream(device)
+        self.copied = [torch.cuda.Event() for _ in range(2)]
+        self.done = [torch.cuda.Event() for _ in range(2)]
+        # The blocks are @support_torch_compile modules whose __call__ goes
+        # straight to self.forward, so nn.Module hooks never fire; wrap
+        # forward on the instance instead.
+        for i, blk in enumerate(self.blocks):
+            blk.forward = self._wrap(i, blk.forward)
+        logger.info(
+            "ViT blocks streamed from host: %d blocks, %.1f MiB resident slots",
+            len(self.blocks),
+            2 * numel * self.slots[0].element_size() / 2**20,
+        )
+
+    def _stage(self, i: int) -> None:
+        slot = i % 2
+        with torch.cuda.stream(self.copy_stream):
+            self.copy_stream.wait_event(self.done[slot])
+            off = 0
+            for h in self.host[i]:
+                n = h.numel()
+                self.slots[slot][off : off + n].view_as(h).copy_(h, non_blocking=True)
+                off += n
+            self.copied[slot].record(self.copy_stream)
+
+    def _wrap(self, i: int, forward):
+        def wrapped(*args, **kwargs):
+            self._pre(i)
+            out = forward(*args, **kwargs)
+            self._post(i)
+            return out
+
+        return wrapped
+
+    def _pre(self, i: int) -> None:
+        slot = i % 2
+        if i == 0:
+            self._stage(0)
+        torch.cuda.current_stream().wait_event(self.copied[slot])
+        off = 0
+        for p, h in zip(self.params[i], self.host[i]):
+            n = h.numel()
+            p.data = self.slots[slot][off : off + n].view_as(h)
+            off += n
+        if i + 1 < len(self.blocks):
+            self._stage(i + 1)
+
+    def _post(self, i: int) -> None:
+        self.done[i % 2].record(torch.cuda.current_stream())
+        for p, h in zip(self.params[i], self.host[i]):
+            p.data = h
+
+
